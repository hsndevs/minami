{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/banner-slider",
  "version": "0.1.2",
  "title": "Banner Slider",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "banner-slider",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "images": {
      "type": "array",
      "default": []
    },
    "sliderHeight": {
      "type": "number",
      "default": 700
    },
    "tabletHeight": {
      "type": "number",
      "default": 400
    },
    "mobileHeight": {
      "type": "number",
      "default": 300
    },
    "themeImageUrl": {
      "type": "string",
      "default": "/wp-content/themes/minami/assets/images/"
    }
  }
}